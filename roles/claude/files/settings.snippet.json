{
  "_comment": "Personal-portable subset of ~/.claude/settings.json. Copy these entries into your live settings.json (merge with any org-specific env/plugins/marketplace entries). Top-level keys are shallow-merged by Claude, so within permissions/hooks/etc. you must combine arrays yourself.",

  "attribution": {
    "commit": "🤖 Generated with [Claude Code](https://claude.com/claude-code)\n\nCo-Authored-By: Claude <noreply@anthropic.com>"
  },

  "model": "opus",
  "availableModels": ["opus", "sonnet", "haiku"],

  "skillListingBudgetFraction": 0.05,
  "showClearContextOnPlanAccept": true,
  "skipWorkflowUsageWarning": true,

  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if echo \"$CLAUDE_TOOL_INPUT\" | grep -qE 'git (checkout -b|switch -c) |git branch [^-]' && ! echo \"$CLAUDE_TOOL_INPUT\" | grep -qE 'git (checkout -b|switch -c|branch) twentylemon/'; then echo 'Branch name must start with twentylemon/' >&2; exit 2; fi"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/git-twentylemon-gate.sh"
          },
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/gh-api-write-gate.sh"
          }
        ]
      }
    ]
  },

  "permissions": {
    "defaultMode": "plan",
    "allow": [
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(find:*)",
